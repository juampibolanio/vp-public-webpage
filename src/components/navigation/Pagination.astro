---
/**
 * Pagination
 *
 * Pagination component for news listings.
 *
 * Responsibilities:
 * - Render previous / next navigation.
 * - Display page numbers based on total pages.
 * - Highlight the current page.
 *
 * Accessibility:
 * - Uses semantic <nav> and <aria-current>.
 * - Disables navigation when limits are reached.
 *
 * Props:
 * - currentPage: number — active page.
 * - totalPages: number — total available pages.
 */
import "./Pagination.css";

interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props as Props;

const createPageUrl = (page: number) => `${basePath}?page=${page}`;

const delta = 2;

const range: (number | string)[] = [];

const left = Math.max(2, currentPage - delta);
const right = Math.min(totalPages - 1, currentPage + delta);

range.push(1);

if (left > 2) {
  range.push("ellipsis-left");
}

for (let i = left; i <= right; i++) {
  range.push(i);
}

if (right < totalPages - 1) {
  range.push("ellipsis-right");
}

if (totalPages > 1) {
  range.push(totalPages);
}
---

<nav class="pagination" aria-label="Paginación">
  <ul class="pagination__list">
    <li class={`pagination__item ${currentPage === 1 ? "pagination__item--disabled" : ""}`}>
      {currentPage === 1 ? (
        <span aria-disabled="true">Anterior</span>
      ) : (
        <a href={createPageUrl(currentPage - 1)} data-astro-reload>
          Anterior
        </a>
      )}
    </li>

    {range.map((item) => (
      <li
        class={`pagination__item ${
          item === currentPage ? "pagination__item--active" : ""
        }`}
      >
        {typeof item === "string" ? (
          <span class="pagination__ellipsis">…</span>
        ) : item === currentPage ? (
          <span aria-current="page">{item}</span>
        ) : (
          <a href={createPageUrl(item)} data-astro-reload>
            {item}
          </a>
        )}
      </li>
    ))}

    <li
      class={`pagination__item ${
        currentPage === totalPages ? "pagination__item--disabled" : ""
      }`}
    >
      {currentPage === totalPages ? (
        <span aria-disabled="true">Siguiente</span>
      ) : (
        <a href={createPageUrl(currentPage + 1)} data-astro-reload>
          Siguiente
        </a>
      )}
    </li>
  </ul>
</nav>