---
/**
 * Footer
 *
 * Global site footer.
 *
 * Responsibilities:
 * - Display brand identity and mission statement.
 * - Provide primary navigation, institutional, and legal links.
 * - Show copyright and developer attribution.
 *
 * This component is static and present on all pages.
 */
import './Footer.css';
import footer_icon from '../../assets/footer-icon.webp';

---

<footer class="footer">
    <div class="footer__main-content">
        <div class="main-content__info-container">
            <div class="info-container__image-wrapper">
                <img class="info-container__image" src={footer_icon.src} alt="Logo de Vivir Plenamente" title="Vivir Plenamente">
                <p class="info-container__title">Vivir Plenamente</p>
            </div>
            <p class="info-container__description">
                En Vivir Plenamente promovemos un envejecimiento saludable, activo y empoderado. Además difundimos y defendemos los derechos consagrados en la Convención Interamericana de los Derechos Humanos de las Personas Mayores, Ley Nacional N°27360/17.
            </p>
        </div>

        <div class="main-content__navegation-container">
            <div class="sections-container">
                <h5 class="sections-container__title">Secciones</h5>
                <div class="sections-container__links">
                    <a class="links__item" href="#ayuda-inmediata">
                        <span class="item__title">Ayuda Inmediata</span>
                    </a>
                    <a class="links__item" href="/">
                        <span class="item__title">Inicio</span>
                    </a>
                    <a class="links__item" href="personas-mayores">
                        <span class="item__title">Personas Mayores</span>
                    </a>
                    <a class="links__item" href="#profesionales">
                        <span class="item__title">Profesionales</span>
                    </a>
                    <a class="links__item" href="/noticias">
                        <span class="item__title">Noticias</span>
                    </a>
                    <a class="links__item" href="#whatsapp">
                        <span class="item__title">Whatsapp</span>
                    </a>
                </div>
            </div>

            <div class="institutional-container">
                <h5 class="sections-container__title">Institucional</h5>
                <div class="sections-container__links">
                    <a class="links-item" href="#vivir-plenamente">
                        <span class="item__title">Vivir Plenamente</span>
                    </a>
                    <a class="links__item" href="#contacto">
                        <span class="item__title">Contacto</span>
                    </a>
                    <a class="links__item" href="#colaboracion">
                        <span class="item__title">Colaboración</span>
                    </a>
                </div>
            </div>

            <div class="legal-container">
                <h5 class="sections-container__title">Legal</h5>
                <div class="sections-container__links">
                    <a class="links-item" href="#terminos-y-condiciones">
                        <span class="item__title">Términos y Condiciones</span>
                    </a>
                    <a class="links-item" href="#politica-de-privacidad">
                        <span class="item__title">Política de Privacidad</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="footer__bottom-bar">
        <p class="footer__copyright">© 2026 Vivir Plenamente. Todos los derechos reservados.</p>

        <a href="https://chacuio.site/" class="footer__developed">Desarrollado por <span class="developed_name">Chacú.IO</span></a>
    </div>
</footer>
