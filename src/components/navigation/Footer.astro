---
/**
 * Footer
 *
 * Global site footer.
 *
 * Responsibilities:
 * - Display brand identity and mission statement.
 * - Provide primary navigation, institutional, and legal links.
 * - Show copyright and developer attribution.
 *
 * This component is static and present on all pages.
 */
import "./Footer.css";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__main-content">
    <div class="main-content__info-container">
      <div class="info-container__image-wrapper">
        <img
          class="info-container__image"
          src="/assets/footer-icon.webp"
          alt="Logo de Vivir Plenamente"
          loading="lazy"
          decoding="async"
        />
        <p class="info-container__title">Vivir Plenamente</p>
      </div>

      <p class="info-container__description">
        En Vivir Plenamente promovemos un envejecimiento saludable, activo y
        empoderado. Además difundimos y defendemos los derechos consagrados en
        la Convención Interamericana de los Derechos Humanos de las Personas
        Mayores, Ley Nacional N°27360/17.
      </p>
    </div>

    <div class="main-content__navegation-container">
      <nav class="sections-container" aria-label="Secciones">
        <h5 class="sections-container__title">Secciones</h5>
        <div class="sections-container__links">
          <a class="links__item" href="https://wa.link/2s0wl1"
            >Ayuda Inmediata</a
          >
          <a class="links__item" href="/">Inicio</a>
          <a class="links__item" href="/adultos-mayores">Personas Mayores</a>
          <a class="links__item" href="/profesionales">Profesionales</a>
          <a class="links__item" href="/noticias">Noticias</a>
          <a class="links__item" href="https://wa.link/2s0wl1">Whatsapp</a>
        </div>
      </nav>

      <nav class="sections-container" aria-label="Institucional">
        <h5 class="sections-container__title">Institucional</h5>
        <div class="sections-container__links">
          <a class="links__item" href="/sobre-vivir-plenamente"
            >Vivir Plenamente</a
          >
          <a class="links__item" href="/contacto">Contacto</a>
          <a class="links__item" href="/donaciones">Colaboración</a>
        </div>
      </nav>

      <nav class="sections-container" aria-label="Legal">
        <h5 class="sections-container__title">Legal</h5>
        <div class="sections-container__links">
          <a class="links__item" href="/terminos-y-condiciones"
            >Términos y Condiciones</a
          >
          <a class="links__item" href="/politica-de-privacidad"
            >Política de Privacidad</a
          >
        </div>
      </nav>
    </div>
  </div>

  <div class="footer__bottom-bar">
    <p class="footer__copyright">
      © {year} Vivir Plenamente. Todos los derechos reservados.
    </p>

    <a href="https://chacuio.site/" class="footer__developed">
      Desarrollado por <span class="developed_name">Chacú.IO</span>
    </a>
  </div>
</footer>
