---
/**
 * ArticleItem
 *
 * Reusable presentation component for rendering an article card within
 * listings, grids, or feeds.
 *
 * Responsibilities:
 * - Displays core editorial information: author, category, publish date,
 *   title, excerpt, and cover image.
 * - Provides multiple, consistent navigation entry points to the article
 *   detail view via the supplied `href`.
 *
 * Data contract:
 * - Expects a normalized `articles` object with resolved author avatar,
 *   cover media, and publication date.
 * - Receives `href` externally to decouple routing logic from presentation.
 *
 * Performance & UX considerations:
 * - Uses native lazy-loading and async decoding for images to optimize
 *   list performance.
 */

import { formatDate } from "../../utils/date";
import "./ArticleItem.css";

const { articles, href } = Astro.props;

const { title, slug, excerpt, category, cover, publishedDate, author } =
  articles;

const formattedDate = publishedDate ? formatDate(publishedDate) : null;

const coverUrl = cover?.url ?? null;
const coverAlt = cover?.alt ?? title ?? "Imagen del artículo";

const authorAvatarUrl = author?.avatar?.url ?? null;
const authorAvatarAlt = author?.avatar?.alt ?? author?.name ?? "Autor";
---

<article class="article-item">
  <div class="article__author">
    {
      authorAvatarUrl ? (
        <img
          class="article__author-image"
          src={authorAvatarUrl}
          alt={authorAvatarAlt}
          loading="lazy"
          decoding="async"
          width="48"
          height="48"
        />
      ) : (
        <div class="article__author-placeholder" />
      )
    }

    <div class="article__author-info">
      <span class="author-info__text">Por</span>
      <span class="author-info__name">{author?.name ?? "—"}</span>
    </div>
  </div>

  <div class="article__image-wrapper">
    <a href={href} class="article__link">
      {
        coverUrl ? (
          <img
            class="article__image"
            src={coverUrl}
            alt={coverAlt}
            loading="lazy"
            decoding="async"
            width="800"
            height="450"
          />
        ) : (
          <div class="article__image-placeholder" />
        )
      }
    </a>
  </div>

  <div class="article__meta-info">
    <span class="meta-category">{category}</span>
    <span class="meta-date">{formattedDate}</span>
  </div>

  <div class="article__body">
    <h3 class="article__body-title">
      <a href={href} class="article__link article__link--title">
        {title}
      </a>
    </h3>

    {
      excerpt && (
        <p class="article__body-description">
          {" "}
          <a href={href} class="article__link article__link--excerpt">
            {" "}
            {excerpt}{" "}
          </a>{" "}
        </p>
      )
    }
  </div>
</article>
