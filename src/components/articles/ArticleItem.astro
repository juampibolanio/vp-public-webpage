---
import "./ArticleItem.css";

const imageItem =
  "https://vivirplenamente.com.ar/wp-content/uploads/2022/08/seguro-de-hogar.jpg";

const authorImage =
  "https://www.radiosudamericana.com/notix/multimedia/imagenes/fotos/2025-05-29/924525.jpeg_nota.jpeg";

const href = "/articulos/cobertura-integral-hogar";
---

<article class="article-item">
  <div class="article__author">
    <img
      class="article__author-image"
      src={authorImage}
      alt="Mirian Blanchard"
      loading="lazy"
      decoding="async"
    />

    <div class="article__author-info">
      <span class="author-info__name">Mirian Blanchard</span>
      <span class="author-info__role">Redactora</span>
    </div>
  </div>

  <div class="article__image-wrapper">
    <a href={href} class="article__link">
      <img
        class="article__image"
        src={imageItem}
        alt="Cobertura Integral del Hogar"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>

  <div class="article__meta-info">
    <span class="meta-category">Categoría</span>
    <span class="meta-divider"></span>
    <span class="meta-date">28 de febrero</span>
  </div>

  <div class="article__body">
    <h3 class="article__body-title">
      <a href={href} class="article__link article__link--title">
        Cobertura Integral del Hogar: ¿Qué alcance tiene?
      </a>
    </h3>

    <p class="article__body-description">
      <a href={href} class="article__link article__link--excerpt">
        Días atrás, en nuestra Ciudad, una pantalla gigante durante un show de
        chamamé se desplomó sobre la artista que actuaba en el momento.
      </a>
    </p>
  </div>
</article>
