---
import Breadcrumb from "../../components/shared/Breadcrumb.astro";
import TitleBarTopPage from "../../components/shared/TitleBarTopPage.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Sidebar from "../../components/shared/Sidebar.astro";
import Pagination from "../../components/news/Pagination.astro";
import FeaturedArticle from "../../components/articles/FeaturedArticle.astro";
import ArticlesList from "../../components/articles/ArticlesList.astro";

const breadcrumbItems = [
  { label: "Inicio", href: "/" },
  { label: "Artículos", href: "/articulos" },
  { label: `Página 1`, href: null },
];
---

<MainLayout>
  <div class="articles-layout">
    <div class="articles-layout__header">
      <Breadcrumb items={breadcrumbItems} />
    </div>

    <TitleBarTopPage title="Artículos" />

    <div class="articles-layout__wrapper">
      <div class="articles-layout__description">
        <p class="articles-layout__text">
          Explora nuestros artículos más recientes y destacados sobre diversos
          temas de interés.
        </p>
      </div>

      <div class="articles-layout__featured">
        <FeaturedArticle />
      </div>

      <div class="articles-layout__body">
        <div class="articles-layout__content">
          <div class="articles-layout__grid">
            <ArticlesList />
          </div>

          <Pagination />
        </div>

        <aside class="articles-layout__sidebar">
          <Sidebar />
        </aside>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .articles-layout__header {
    max-width: 1250px;
    margin: 0 auto;
    padding: var(--space-sm);
  }

  .articles-layout__wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-xxl) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xxl);
  }

  .articles-layout__description {
    max-width: 720px;
  }

  .articles-layout__text {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
  }

  .articles-layout__featured {
    width: 100%;
  }

  .articles-layout__body {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xl);
    width: 100%;
  }

  .articles-layout__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .articles-layout__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .articles-layout__sidebar {
    width: 300px;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .articles-layout__sidebar {
      width: 260px;
    }
  }

  @media (max-width: 900px) {
    .articles-layout__body {
      flex-direction: column;
    }

    .articles-layout__sidebar {
      display: none;
    }
  }
</style>
