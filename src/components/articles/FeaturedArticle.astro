---
import { formatDate } from "../../utils/date";
import "./FeaturedArticle.css";
import { Image } from "astro:assets";

const { featArticle, basePath } = Astro.props;

const safeArticle = featArticle ?? {};

const { title, slug, excerpt, category, publishedDate, cover, author } =
  safeArticle;

const formattedDate = publishedDate ? formatDate(publishedDate) : null;

// Safe author
const authorName = author?.name ?? "Autor";
const authorAvatarUrl = author?.avatar?.url ?? null;
const authorAvatarAlt = author?.avatar?.alt ?? authorName;

// Safe cover
const coverUrl = cover?.url ?? null;
const coverAlt = cover?.alt ?? title ?? "Imagen del artículo";

// Safe link
const articleHref = slug ? `${basePath}/${slug}` : "#";
---

<section class="article-featured">
  <div class="article-featured__content">
    <a href={articleHref} class="article__header">
      {
        authorAvatarUrl ? (
          <img
            class="article__image"
            src={authorAvatarUrl}
            alt={authorAvatarAlt}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="article__author-placeholder" />
        )
      }

      <div class="article__author-info">
        <span class="author-info__text">Por</span>
        <span class="author-info__name">{authorName}</span>
      </div>
    </a>

    <div class="article__body">
      <a href={articleHref}>
        <h3 class="article__title">{title}</h3>
      </a>

      {excerpt && <p class="article__description">{excerpt}</p>}
    </div>

    <div class="article__footer">
      <div class="article__meta">
        {category && <span class="article__category">{category}</span>}

        {
          formattedDate && (
            <>
              <span class="article__divider" />
              <span class="article__date">{formattedDate}</span>
            </>
          )
        }
      </div>

      <a href={articleHref} class="article__read-button">
        <span class="article__button">Leer</span>
      </a>
    </div>
  </div>

  <div class="article-featured__media">
    <a class="article__featured-image-wrapper" href={articleHref}>
      {
        coverUrl ? (
          <img
            class="article__featured-image"
            src={coverUrl}
            alt={coverAlt}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="article__featured-placeholder" />
        )
      }
    </a>
  </div>
</section>
