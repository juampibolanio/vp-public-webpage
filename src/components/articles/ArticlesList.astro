---
/**
 * ArticlesList
 *
 * Container component responsible for rendering a grid of article cards.
 *
 * Responsibilities:
 * - Receives a collection of normalized article objects.
 * - Limits the rendered output to a maximum of 6 items to control layout
 *   density and visual hierarchy.
 * - Delegates individual article rendering to the `ArticleItem` component.
 *
 * Data contract:
 * - `articles`: Array of normalized article objects. If the value is not
 *   an array, the component safely falls back to an empty list.
 * - `basePath`: Base URL segment used to construct article detail links.
 *
 * Routing strategy:
 * - Article URLs are composed externally using `basePath` and `article.slug`,
 *   keeping routing logic explicit and predictable.
 */

//@ts-nocheck
import ArticleItem from "./ArticleItem.astro";
import "./ArticlesList.css";

const { articles, basePath } = Astro.props;

const items = Array.isArray(articles) ? articles.slice(0, 6) : [];
---

<section class="article-list">
  <div class="article-list__grid">
    {items.map((article) => 
      <ArticleItem 
        articles={article} 
        href={`${basePath}/${article.slug}`}
      />)}
  </div>
</section>
