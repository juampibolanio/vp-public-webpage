---
//@ts-nocheck
import { never } from "astro:schema";
import "./RelatedNews.css";

const { relatedNews = [] } = Astro.props;

const safeNews = relatedNews
  .filter((item) => item?.slug && item?.title)
  .slice(0, 3);

if (safeNews.length === 0) {
  return null;
}
---

<section class="related-news" aria-labelledby="related-news-title">
  <h2 class="related-news__title" id="related-news-title">Noticias relacionadas</h2>

  <div class="related-news__grid">
    {
      safeNews.map((news) => {
        const hasImage = news.media?.thumbnail || news.media?.url;

        const categorySlug =
          typeof news.category === "string"
            ? news.category.toLowerCase()
            : news.category?.slug;

        const categoryLabel =
          typeof news.category === "string"
            ? news.category
            : news.category?.label;

        return (
          <article class="related-news__card" key={news.slug}>
            {hasImage ? (
              <img
                src={news.media.thumbnail || news.media.src}
                alt={news.media?.alt || news.title}
                class="related-news__image"
                loading="lazy"
                decoding="async"
                width="400"
                height="150"
              />
            ) : (
              <div class="related-news__image related-news__image--placeholder" />
            )}

            {categorySlug && (
              <a
                href={`/noticias/categoria/${categorySlug}`}
                class="related-news__category"
              >
                {categoryLabel}
              </a>
            )}

            <h3 class="related-news__headline">
              <a
                href={`/noticias/${news.slug}`}
                class="related-news__headline-link"
              >
                {news.title}
              </a>
            </h3>
          </article>
        );
      })
    }
  </div>
</section>
