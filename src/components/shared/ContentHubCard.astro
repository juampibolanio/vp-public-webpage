---
/**
 * ContentHubCard
 *
 * Reusable card component representing a content hub entry.
 *
 * Responsibilities:
 * - Displays hub icon, title, and short description.
 * - Provides a clear call-to-action linking to the hub detail page.
 *
 * Data contract:
 * - Expects normalized hub data (`title`, `description`, `icon`, `slug`).
 * - `basePath` is optional and allows reuse across different sections.
 */
import "./ContentHubCard.css";

const { title, description, icon, slug, basePath = "" } = Astro.props;

const href = `${basePath}/${slug}`;
---

<article class="content-hub-card">
  <div class="content-hub__image-wrapper">
    <img
      class="content-hub__icon"
      src={icon.url}
      alt={icon.alt || icon.title || ""}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="content-hub__content">
    <h3 class="content-hub__title">{title}</h3>
    <p class="content-hub__description">{description}</p>
  </div>

  <a href={href} class="content-hub__button">
    <span class="content-hub__button-text">Ver</span>
  </a>
</article>
