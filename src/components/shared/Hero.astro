---
/**
 * Hero
 *
 * Main homepage hero section.
 *
 * Purpose:
 * - Establish brand identity.
 * - Present the primary message of the platform.
 * - Provide clear primary CTAs for help and news access.
 *
 * This component is static and layout-focused.
 * It is intended to be visually prominent and accessible.
 */
import "./Hero.css";
---

<section class="hero">
  <picture class="hero__bg">
    <source
      srcset="/assets/hero-mobile.webp"
      media="(max-width: 600px)"
    />
    <img
      src="/assets/hero-desktop.webp"
      alt=""
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      aria-hidden="true"
    />
  </picture>

  <div class="hero__overlay"></div>

  <div class="hero__content">
    <div class="hero__header">
      <img
        src="/assets/footer-icon.webp"
        alt="Vivir Plenamente"
        class="hero__logo"
        width="240"
        height="240"
        loading="eager"
        decoding="async"
      />

      <h1 class="hero__title">
        <span class="hero__title-vivir">VIVIR</span>
        <span class="hero__title-plenamente">PLENAMENTE</span>
      </h1>
    </div>

    <p class="hero__subtitle">Periodismo especializado en vejez</p>

    <div class="hero__buttons">
      <a href="https://wa.link/2s0wl1" class="hero__button">
        Necesito ayuda ahora
      </a>
      <a href="/noticias" class="hero__button">
        Leer las últimas noticias
      </a>
    </div>
  </div>
</section>
