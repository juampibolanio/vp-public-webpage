---
/**
 * BroadcastSchedules
 *
 * Displays the radio broadcast schedule for Vivir Plenamente.
 *
 * Includes:
 * - Program logo
 * - Section title
 * - Broadcast day and time
 * - External link to the radio station
 *
 * This component is static and informational.
 */
import './BroadcastSchedules.css';
import { Icon } from 'astro-icon/components';

---

<div class="emission-footer">
        <div class="emission-content">
            <img src="/assets/home-icon.webp" alt="Logo Vivir Plenamente" class="emission-logo" />
            <div class="emission-text">
                <h4 class="emission-title">Horarios de emisión</h4>
                <div class="emission-info">
                    <Icon name="mdi:arrow-right-thick" class="arrow-icon" />
                    <p>
                        Domingos de 8 a 10hs <br />
                        <a href="https://www.radiosudamericana.com" target="_blank">www.radiosudamericana.com</a>
                    </p>
                </div>
            </div>
        </div>
    </div>