---
//@ts-nocheck
const res = await fetch(Astro.url.origin + "/api/weather.json");
const data = await res.json();

if (!data || data.error) {
  throw new Error("Weather unavailable");
}

const { current, forecast } = data;
---

<section class="weather-sections">
  <header class="weather__header">
    <h4 class="weather__title">{current.name}</h4>
    <span class="weather__state">
      {
        current.weather[0].description.charAt(0).toUpperCase() +
          current.weather[0].description.slice(1)
      }
    </span>
  </header>

  <div class="weather__body">
    <div class="weather__stats">
      <div class="weather__stat">
        <span class="weather__stat-value">{current.main.humidity}%</span>
        <span class="weather__stat-label">Humedad</span>
      </div>

      <div class="weather__stat">
        <span class="weather__stat-value">
          {Math.round(current.wind.speed * 3.6)} km/h
        </span>
        <span class="weather__stat-label">Viento</span>
      </div>

      <div class="weather__stat">
        <span class="weather__stat-value">
          {Math.round(current.main.feels_like)}°
        </span>
        <span class="weather__stat-label">Sen. térmica</span>
      </div>
    </div>

    <div class="weather__temperature">
      <img
        src={`https://openweathermap.org/img/wn/${current.weather[0].icon}@2x.png`}
        alt={current.weather[0].description}
        width="80"
        height="80"
        loading="lazy"
      />

      <span class="weather__temp-value">
        {Math.round(current.main.temp)}°
      </span>

      <div class="weather__temp-range">
        <span>Min {Math.round(current.main.temp_min)}°</span>
        <span>Max {Math.round(current.main.temp_max)}°</span>
      </div>
    </div>
  </div>

  <footer class="weather__forecast">
    {
      forecast.map((day) => {
        const date = new Date(day.dt * 1000);
        const label = date.toLocaleDateString("es-AR", {
          weekday: "short",
        });

        return (
          <div class="weather__forecast-day">
            <img
              src={`https://openweathermap.org/img/wn/${day.weather[0].icon}.png`}
              alt={day.weather[0].description}
              width="40"
              height="40"
              loading="lazy"
            />
            <span>{label}</span>
            <span>{Math.round(day.main.temp)}°</span>
          </div>
        );
      })
    }
  </footer>
</section>

<style>
  .weather-sections {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .weather__header {
    display: flex;
    flex-direction: column;
  }

  .weather__title {
    font-size: var(--font-size-lg);
    font-weight: 600;
    margin: 0;
  }

  .weather__state {
    font-size: 0.85rem;
  }

  .weather__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .weather__stats {
    display: flex;
    justify-content: space-between;
  }

  .weather__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 0.75rem;
  }

  .weather__stat-value {
    font-weight: 600;
  }

  .weather__temperature {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-lg);
  }

  .weather__temp-icon-container {
    width: 96px;
    height: 96px;
  }

  .weather__temp-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .weather__temp-value {
    font-size: 2rem;
    font-weight: 600;
  }

  .weather__temp-range {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .weather__forecast {
    display: flex;
    justify-content: space-between;
  }

  .weather__forecast-day {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 0.75rem;
  }

  .weather__forecast-label {
    font-weight: 500;
  }

  .weather__forecast-temp {
    font-size: 0.8rem;
  }
</style>
