---
import './EventCard.css';
import { Icon } from 'astro-icon/components';

const { event } = Astro.props;

---

<article class="event-item">
  <div class="event__image-wrapper">
    <a href={`/profesionales/capacitaciones-y-congresos/${event.slug}`} class="event__link">
      <img
        class="event__image"
        src={event.media[0]?.url || '/placeholder-event.jpg'}
        alt={event.media[0]?.alt || event.title}
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>

  <div class="event__content">
    <div class="event__meta-info">
      <span class="meta-date">
        <Icon name="mdi:calendar-range" class="meta-icon" />
        Del {event.startDate} al {event.endDate}
      </span>
    </div>

    <div class="event__body">
      <h3 class="event__body-title">
        <a href={`/profesionales/capacitaciones-y-congresos/${event.slug}`} class="event__link event__link--title">
          {event.title}
        </a>
      </h3>

      {event.excerpt && (
        <p class="event__body-description">
          <a href={`/profesionales/capacitaciones-y-congresos/${event.slug}`} class="event__link event__link--excerpt">
            {event.excerpt}
          </a>
        </p>
      )}

      <div class="event__details">
        <p class="event__detail-item">
          <Icon name="mdi:map-marker" class="detail-icon" />
          <span>{event.location}</span>
        </p>
        <p class="event__detail-item">
          <Icon name="mdi:domain" class="detail-icon" />
          <span><strong>Organiza:</strong> {event.organizer}</span>
        </p>
        <p class="event__detail-item">
          <Icon name="mdi:laptop" class="detail-icon" />
          <span><strong>Modalidad:</strong> {event.modality}</span>
        </p>
        <p class="event__detail-item">
          <Icon name="mdi:calendar-star" class="detail-icon" />
          <span><strong>Tipo de evento:</strong> {event.eventType}</span>
        </p>
      </div>
    </div>
  </div>
</article>