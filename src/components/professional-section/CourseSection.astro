---
//@ts-nocheck
import CourseCard from "./CourseCard.astro";
import "./CourseSection.css";

const { courses } = Astro.props;

---

<div class="courses-cards-wrapper">
  {
    courses.map((event) => (
      <CourseCard slug={event.slug} />
    ))
  }

  <div class="courses-cards__button-wrapper">
    <a class="courses-cards__button" href="/profesionales/capacitaciones-y-congresos">Ver todos los eventos</a>
  </div>
</div>
