---
import { formatDate } from "../../utils/date";
import "./NewsItem.css";

const { news } = Astro.props;

const { title, slug, excerpt, category, publishedDate, media, author } = news;

const formattedDate = formatDate(publishedDate);
---

<article class="news-item">
  <a
    href={`/noticias/${slug}`}
    class="news-item__link"
    aria-labelledby={`news-title-${slug}`}></a>

  {
    media && (
      <div class="news-item__image-wrapper">
        <img
          class="news-item__image"
          src={media.src}
          alt={media.alt || title}
          width="280"
          height="180"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="news-item__content-wrapper">
    <div class="news-item__meta">
      <span class="news-item__category">{category}</span>
      <span class="news-item__meta-divider"></span>
      <span class="news-item__published-date">{formattedDate}</span>
    </div>

    <div class="news-item__content">
      <h3 class="news-item__title" id={`news-title-${slug}`}>
        {title}
      </h3>

      <p class="news-item__excerpt">
        {excerpt}
      </p>
    </div>

    {
      author && (
        <div class="news-item__author">
          <span class="news-item__author-name">Por {author.name}</span>
        </div>
      )
    }
  </div>
</article>
