---
/**
 * NewsItem
 *
 * Renders a single news card for list views.
 *
 * Responsibilities:
 * - Display cover image, category, date, title, excerpt, and author.
 * - Link to the news detail page.
 *
 * Props:
 * - news: normalized news object.
 *
 * Notes:
 * - Uses lazy-loaded media for performance.
 * - Date formatting is delegated to a shared utility.
 */
import { formatDate } from "../../utils/date";
import "./NewsItem.css";

const { news } = Astro.props;

const { title, slug, excerpt, category, publishedDate, media, author } = news;

const formattedDate = formatDate(publishedDate);
---

<article class="news-item">
  <a
    href={`/noticias/${slug}`}
    class="news-item__link"
    aria-label={`Leer noticia: ${title}`}></a>

  {
    media && (
      <div class="news-item__image-wrapper">
        <img
          class="news-item__image"
          src={media.thumbnail || media.url}
          alt={media.alt || title}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="news-item__content-wrapper">
    <div class="news-item__meta">
      <span class="news-item__category">{category}</span>
      <span class="news-item__meta-divider"></span>
      <span class="news-item__published-date">{formattedDate}</span>
    </div>

    <div class="news-item__content">
      <h3 class="news-item__title">
        {title}
      </h3>

      <p class="news-item__excerpt">
        {excerpt}
      </p>
    </div>

    {
      author && (
        <div class="news-item__author">
          <span class="news-item__author-name">Por {author.name}</span>
        </div>
      )
    }
  </div>
</article>
