---
import { formatDate } from "../../utils/date";
import "./NewsItem.css";

const { news } = Astro.props;

const { title, slug, excerpt, category, publishedDate, media, author } = news;
console.log(category);

const formattedDate = formatDate(publishedDate);
---

<article class="news-item">
  {
    media && (
      <a
        class="news-item__image-wrapper"
        href={`/noticias/${slug}`}
        aria-hidden="true"
        tabindex="-1"
      >
        <img
          class="news-item__image"
          src={media.src}
          alt={media.alt || title}
          width="280"
          height="180"
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }

  <div class="news-item__content-wrapper">
    <div class="news-item__meta">
      <a href={`/noticias/categoria/${category}`} class="news-item__category">
        {category}
      </a>
      <span class="news-item__meta-divider"></span>
      <time class="news-item__published-date" datetime={publishedDate}>
        {formattedDate}
      </time>
    </div>

    <div class="news-item__content">
      <h2 class="news-item__title">
        <a
          href={`/noticias/${slug}`}
          class="news-item__title-link"
          id={`news-title-${slug}`}
        >
          {title}
        </a>
      </h2>

      {excerpt && <p class="news-item__excerpt">{excerpt}</p>}
    </div>

    {
      author && (
        <div class="news-item__author">
          <span class="news-item__author-name">Por {author.name}</span>
        </div>
      )
    }
  </div>
</article>
