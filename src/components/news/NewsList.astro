---
//@ts-nocheck
/**
 * NewsList
 *
 * Renders a grid/list of news items.
 *
 * Responsibilities:
 * - Receive an array of news items.
 * - Render a limited subset for layout consistency.
 *
 * Props:
 * - news: Array of normalized news objects.
 *
 * Notes:
 * - Limits rendering to the first 4 items.
 * - Delegates item rendering to NewsItem.
 */
import NewsItem from './NewsItem.astro';
import './NewsList.css';

const { news = [], limit = 4 } = Astro.props;
const items = news.slice(0, limit);
---

<section class="news-list">
    {items.map((item) => (
        <NewsItem news={item} key={item.slug}/>
    ))}
</section>