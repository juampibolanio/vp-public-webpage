---
import './UsefulPhones.css';
import { Icon } from 'astro-icon/components';
import { getUsefulPhones } from '../../services/useful-phones.service';

const { data, error: fetchError } = await getUsefulPhones();
const TYPE_LABELS = {
    URGENCIA: 'URGENCIA',
    ATENCION_24_HRS: 'ATENCIÓN 24 HRS'
};
---

<main class="page-container">
    
    <header class="page-header">
        <div class="header-content">
            <p class="header-desc">
            Guía completa de contacto de servicios públicos, emergencias y organismos oficiales para Corrientes y la región del NEA.
            </p>
        </div>
    </header>

    {fetchError && (
        <div style="text-align: center; color: red; padding: 2rem;">
        <p>{fetchError}</p>
        </div>
    )}

    <div class="phones-content">
        {data.map((category: any) => {
        if (category.cards.length === 0) return null;

        const isEmergency = category.slug === 'EMERGENCY';

        return (
            <section class="category-section">
            
                <div class="category-header">
                    <h2>{category.categoryTitle}</h2>
                    <div class="header-line"></div>
                </div>
                
                <div class="cards-grid">
                    {category.cards.map((card: any) => (
                    <article class={`phone-card ${isEmergency ? 'card-emergency' : 'card-standard'}`}>
                        
                        <div class="card-top">
                            {isEmergency ? (
                                <div class="icon-circle emergency-bg-icon">
                                <Icon name={card.icon || 'mdi:shield-alert'} class="card-icon-svg" />
                                </div>
                            ) : (
                                <div class="logo-wrapper">
                                {card.logo ? (
                                    <img src={card.logo} alt={`Logo ${card.name}`} class="card-img-logo" />
                                ) : (
                                    <div class="icon-circle standard-bg-icon">
                                    <Icon name={card.icon || "mdi:phone"} class="card-icon-svg" />
                                    </div>
                                )}
                                </div>
                            )}

                            {card.type && (
                                <span class={`status-tag ${card.type === 'URGENCIA' ? 'tag-red' : 'tag-blue'}`}>
                                {TYPE_LABELS[card.type as keyof typeof TYPE_LABELS] || card.type}
                                </span>
                            )}
                        </div>

                        <div class="card-body">
                            <h3 class="card-name">{card.name}</h3>

                            {card.subtitle && <p class="card-subtitle">{card.subtitle}</p>}

                            <div class="phone-display">
                                <span class="number-text">{card.phone}</span>
                            </div>
                        </div>

                        <div class="card-actions">
                            {card.actions.map((action: any) => {
                                const rawData = action.linkValue || action.value || '';
                                if (!rawData) return null;

                                const finalHref = `tel:${rawData.replace(/[^\d+]/g, '')}`;
                                
                                return (
                                <a 
                                    href={finalHref} 
                                    class={`btn-action ${isEmergency ? 'btn-black' : 'btn-orange'}`}
                                >
                                    <Icon name="mdi:phone" class="btn-icon-small" />
                                    {action.label}
                                </a>
                                );
                            })}
                        </div>

                    </article>
                    ))}
                </div>
            </section>
        );
        })}
    </div>
</main>
