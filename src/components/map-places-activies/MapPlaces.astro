---
//@ts-nocheck
import MapPlacesIsland from '../../islands/MapPlaces/MapPlaces.jsx'; 
import { getPlaces } from '../../services/places.service.js';
import { getUniqueCategories } from '../../utils/places-normalizer.js';

const response = await getPlaces();
const rawPlaces = (response && Array.isArray(response.data)) ? response.data : [];

function isValidPlace(p: any): boolean {
  return (
    typeof p === 'object' && 
    p !== null &&
    typeof p.id === 'number' &&
    typeof p.title === 'string' &&
    Array.isArray(p.coords)
  );
}
const places = rawPlaces.filter(isValidPlace);
const categories = getUniqueCategories(places) ?? [];
---

<MapPlacesIsland 
  client:only="react" 
  initialPlaces={places} 
  initialCategories={categories} 
/>