---
//@ts-nocheck
import './NewsAndRights.css';
import { formatDate } from '../../utils/date.js'
import { getNews } from '../../services/news.service';

/* get news to list */
const { news: listNews } = await getNews({
  page: 1,
  pageSize: 4,
});

---

<!-- Nota: Se deben revisar los <a>, ya que deben tener el href y redirigir a la noticia correspondiente. Revisar. -->

<section class="container-news-rights">
    <div class="container__header">
        <h2 class="header__title">Actualidad y derechos</h2>

        <p class="header__subtitle">Información, análisis y debates que impactan en la vida cotidiana de las personas mayores. </p>
    </div>

    <div class="container__news-section">
        
        <article class="news-featured">
            <div class="news-featured__image-container">
                <img src={listNews[0].media.url || listNews[0].media.thumbnail} alt={listNews[0].media.alt || listNews[0].title} class="news-featured__image" />
            </div>

            <div class="news-featured__meta">
                <div class="meta__content">
                    <span class="news-featured__date">
                        {formatDate(listNews[0].publishedDate)}
                    </span>
                    <a aria-label={`Categoría: ${listNews[0].category}`} class="news-featured__category">{listNews[0].category}</a>
                </div>

                <span class="news-featured__author">Por: {listNews[0].author.name}</span>
            </div>

            <a href={`/noticias/${listNews[0].slug}`}  aria-label={`Ver noticia: ${listNews[0].title}`} class="news-featured__title">{listNews[0].title}</a>

            <p class="news-featured__summary">{listNews[0].excerpt}</p>
        </article>

        <aside class="news-list">
            {listNews.slice(1).map(item => (
                <article class="news-list__item">
                    <div class="item__image-wrapper">
                        <img src={item.media.url || item.media.thumbnail} alt={item.media.alt || item.title} class="item__image-img" />
                    </div>

                    <div class="item__content">
                        <a aria-label={`Categoría: ${item.category}`} class="content__category">{item.category}</a>
                        <a aria-label={`Ver noticia: ${item.title}`} href={`/noticias/${item.slug}`} class="content__title">{item.title}</a>

                        <span class="content__author">Por: {item.author.name}</span>
                        <span class="content__date">
                            {formatDate(item.publishedDate)}
                        </span>
                    </div>
                </article>
            ))}

            <a href="/noticias" class="news-list__more" aria-label="Ver todas las noticias">Ver todas las noticias</a>
        </aside>
    </div>

</section>