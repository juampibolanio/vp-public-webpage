---
//@ts-nocheck
import "./NewsAndRights.css";
import { formatDate } from "../../utils/date.js";
import { getNews } from "../../services/news.service";

const { news: listNews = [] } = await getNews({
  page: 1,
  pageSize: 4,
});

const hasNews = Array.isArray(listNews) && listNews.length > 0;
const hasSecondaryNews = listNews.length > 1;
---

<section class="container-news-rights">
  <div class="container__header">
    <h2 class="header__title">Actualidad y derechos</h2>
    <p class="header__subtitle">
      Información, análisis y debates que impactan en la vida cotidiana de las
      personas mayores.
    </p>
  </div>

  {
    hasNews ? (
      <div class="container__news-section">
        <article class="news-featured">
          <div class="news-featured__image-container">
            {listNews[0].media?.src || listNews[0].media?.thumbnail ? (
              <img
                src={listNews[0].media?.src}
                alt={listNews[0].media?.alt || listNews[0].title}
                class="news-featured__image"
                loading="lazy"
              />
            ) : (
              <div class="news-featured__image-placeholder">
                <span>Vivir Plenamente</span>
              </div>
            )}
          </div>

          <div class="news-featured__meta">
            <div class="meta__content">
              <span class="news-featured__date">
                {formatDate(listNews[0].publishedDate)}
              </span>

              <a
                href={`/noticias/categoria/${listNews[0].category}`}
                class="news-featured__category"
                aria-label={`Categoría: ${listNews[0].category}`}
              >
                {listNews[0].category}
              </a>
            </div>

            <span class="news-featured__author">
              Por: {listNews[0].author?.name}
            </span>
          </div>

          <a
            href={`/noticias/${listNews[0].slug}`}
            class="news-featured__title"
            aria-label={`Ver noticia: ${listNews[0].title}`}
          >
            {listNews[0].title}
          </a>

          <p class="news-featured__summary">{listNews[0].excerpt}</p>
        </article>

        {hasSecondaryNews && (
          <aside class="news-list">
            {listNews.slice(1).map((item) => (
              <article class="news-list__item">
                <div class="item__image-wrapper">
                  {item.media?.src || item.media?.thumbnail ? (
                    <img
                      src={item.media?.src}
                      alt={item.media?.alt || item.title}
                      class="item__image-img"
                      loading="lazy"
                    />
                  ) : (
                    <div class="item__image-placeholder">
                      <span>Vivir Plenamente</span>
                    </div>
                  )}
                </div>

                <div class="item__content">
                  <a
                    href={`/noticias/categoria/${item.category}`}
                    class="content__category"
                    aria-label={`Categoría: ${item.category}`}
                  >
                    {item.category}
                  </a>

                  <a
                    href={`/noticias/${item.slug}`}
                    class="content__title"
                    aria-label={`Ver noticia: ${item.title}`}
                  >
                    {item.title}
                  </a>

                  <span class="content__author">Por: {item.author?.name}</span>

                  <span class="content__date">
                    {formatDate(item.publishedDate)}
                  </span>
                </div>
              </article>
            ))}

            <a
              href="/noticias"
              class="news-list__more"
              aria-label="Ver todas las noticias"
            >
              Ver todas las noticias
            </a>
          </aside>
        )}
      </div>
    ) : (
      <div class="news-fallback">
        <h3 class="news-fallback__title">Próximamente nuevas noticias</h3>

        <p class="news-fallback__text">
          Estamos preparando contenidos sobre actualidad, derechos y calidad de
          vida de las personas mayores. Volvé a visitarnos pronto.
        </p>

        <a href="/noticias" class="news-fallback__button">
          Ir a noticias
        </a>
      </div>
    )
  }
</section>
