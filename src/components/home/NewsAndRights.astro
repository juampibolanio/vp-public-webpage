---
import './NewsAndRights.css';
import { formatDate } from '../../utils/date.js'

const news = [
    {
        title: 'Nueva legislación para la protección de los derechos de las personas mayores',
        date: '2024-05-10',
        summary: 'El gobierno ha aprobado una nueva ley que busca fortalecer los derechos y la protección de las personas mayores en diversos ámbitos.',
        link: '/news/legislacion-proteccion-mayores',
        category: 'Legislación',
        image: 'https://img.freepik.com/foto-gratis/pareja-tomas-medias-posando-juntas_23-2148984296.jpg',
        autor: 'Mirian Blanchard'
    },
    {
        title: 'Impacto del envejecimiento poblacional en la economía',
        date: '2024-04-22',
        summary: 'Un análisis detallado sobre cómo el envejecimiento de la población afecta la economía global y qué medidas se están tomando para adaptarse a estos cambios.',
        link: '/news/envejecimiento-economia',
        category: 'Economía',
        image: 'https://img.freepik.com/foto-gratis/pareja-tomas-medias-posando-juntas_23-2148984296.jpg',
        autor: 'Mirian Blanchard'
    },
    {
        title: 'Debate sobre la atención sanitaria para personas mayores',
        date: '2024-03-15',
        summary: 'Expertos y defensores de los derechos de las personas mayores discuten las mejoras necesarias en el sistema de atención sanitaria para este grupo demográfico.',
        link: '/news/atencion-sanitaria-mayores',
        category: 'Salud',
        image: 'https://img.freepik.com/foto-gratis/pareja-tomas-medias-posando-juntas_23-2148984296.jpg',
        autor: 'Mirian Blanchard'
    },
    {
        title: 'Tecnologías innovadoras para mejorar la calidad de vida de las personas mayores',
        date: '2024-02-28',
        summary: 'Exploramos las últimas tecnologías diseñadas para ayudar a las personas mayores a vivir de manera más independiente y segura.',
        link: '/news/tecnologias-calidad-vida-mayores',
        category: 'Tecnología',
        image: 'https://img.freepik.com/foto-gratis/pareja-tomas-medias-posando-juntas_23-2148984296.jpg',
        autor: 'Mirian Blanchard'
    }
]

---

<section class="container-news-rights">
    <div class="container__header">
        <h2 class="header__title">Actualidad y derechos</h2>

        <p class="header__subtitle">Información, análisis y debates que impactan en la vida cotidiana de las personas mayores. </p>
    </div>

    <div class="container__news-section">
        
        <article class="news-featured">
            <div class="news-featured__image-container">
                <img src={news[0].image} alt={news[0].title} class="news-featured__image" />
            </div>

            <div class="news-featured__meta">
                <div class="meta__content">
                    <span class="news-featured__date">
                        <time datetime={news[0].date}>
                                {formatDate(news[0].date)}
                        </time>
                    </span>
                    <a class="news-featured__category">{news[0].category}</a>
                </div>

                <span class="news-featured__author">Por: {news[0].autor}</span>
            </div>

            <a class="news-featured__title">{news[0].title}</a>

            <p class="news-featured__summary">{news[0].summary}</p>
        </article>

        <aside class="news-list">
            {news.slice(1).map(item => (
                <article class="news-list__item">
                    <div class="item__image-wrapper">
                        <img src={item.image} alt={item.title} class="item__image-img" />
                    </div>

                    <div class="item__content">
                        <a class="content__category">{item.category}</a>
                        <a href={item.link} class="content__title">{item.title}</a>

                        <span class="content__author">Por: {item.autor}</span>
                        <span class="content__date">
                            <time datetime={item.date}>
                                {formatDate(item.date)}
                            </time>
                        </span>
                    </div>
                </article>
            ))}

            <a class="news-list__more">Ver todas las noticias</a>
        </aside>
    </div>

</section>