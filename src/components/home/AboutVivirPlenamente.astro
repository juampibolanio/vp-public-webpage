---
/**
 * AboutVivirPlenamente
 *
 * Home section that introduces the "Vivir Plenamente" media outlet.
 *
 * Responsibilities:
 * - Display brand icon and section title.
 * - Present a short institutional description.
 * - Provide a call-to-action linking to the outlet's history/about page.
 *
 * Notes:
 * - Static, content-driven section.
 */
import "./AboutVivirPlenamente.css";
import logoIcon from "../../assets/home-icon.webp";
---

<section class="about-vivir-plenamente__container">
  <div class="about-vivir-plenamente__header">
    <img
      src={logoIcon.src}
      alt="Logo Vivir Plenamente"
      class="vivir-plenamente__icon"
    />
    <h2 class="header-about-vp__tittle">Sobre Vivir Plenamente</h2>
  </div>
  <div class="about-vivir-plenamente__content">
    <p class="content__text">
      "Vivir Plenamente es un medio periodístico especializado que informa,
      orienta y acompaña decisiones concretas de la vida cotidiana desde una
      perspectiva de derechos."
    </p>

    <div class="about-container__button-wrapper">
      <a href="#" class="about-container__button"> Conocé nuestra historia </a>
    </div>

  </div>
</section>
