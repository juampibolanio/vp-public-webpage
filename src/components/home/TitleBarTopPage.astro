---
/**
 * TitleBarTopPage
 *
 * Simple layout component used to display a page-level title
 * at the top of a view or section.
 *
 * Responsibilities:
 * - Renders a prominent heading based on the provided `title` prop.
 * - Provides a consistent visual wrapper for page titles across the site.
 *
 */

import './TitleBarTopPage.css';

const { title } = Astro.props;
---

<div class="title-bar">
    <div class="title-bar__container">
        <h2 class="title-bar__title">{title}</h2>
    </div>
</div>
