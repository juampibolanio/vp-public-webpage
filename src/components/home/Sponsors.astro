---
/**
 * Sponsors Section
 * ----------------
 * Renders a sponsors block with a title, description, and a carousel.
 * The carousel is hydrated on the client only when visible to optimize performance.
 *
 * Data source:
 * - Currently hardcoded.
 * - Intended to be replaced by API data in the future.
 */
//@ts-nocheck
import SponsorsCarousel from "../../islands/SponsorsCarousel/SponsorsCarousel";
import { getAdvertisements } from "../../services/advertisements.service";
import "./Sponsors.css";

const { advertisements } = await getAdvertisements();
---

<section class="sponsors-section">

    <div class="sponsors-section__header">
        <h2 class="sponsors-section__title">Acompañan a Vivir Plenamente</h2>
        <p class="sponsors-section__description">
            Instituciones y empresas comprometidas con una vejez activa y con derechos
        </p>
    </div>

    <div class="sponsors-section__carousel-wrapper">
        <SponsorsCarousel sponsors={advertisements} client:visible />    
    </div>

</section>
