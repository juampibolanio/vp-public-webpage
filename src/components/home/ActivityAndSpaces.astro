---
/**
 * ActivityAndSpaces
 *
 * Home section that promotes the interactive map of activities and community spaces.
 *
 * Responsibilities:
 * - Present a clear title and descriptive context.
 * - Display a representative map image.
 * - Provide a call-to-action linking to the activities map.
 *
 * Notes:
 * - Static, informational section.
 * - Content is oriented to older adults, prioritizing clarity and readability.
 * - Image is optimized with lazy loading for performance.
 */
import './ActivityAndSpaces.css';
import ActivityAndSpacesImage from "../../assets/home-map-image.webp";

---

<section class="activity-container">
  <div class="activity-container__header">
    <h2 class="activity-container__title">
      Actividades y espacios para compartir cerca tuyo
    </h2>
    <p class="activity-container__description">
      Explorá el mapa y encontrá clubes, centros de jubilados, bibliotecas
      populares y mucho más, en Chaco y Corrientes. Espacios pensados para
      encontrarse, aprender, moverse y seguir participando de la vida
      comunitaria.
    </p>
  </div>

  <div class="activity-container__content">
    <div class="activity-container__image-wrapper">
      <img
        class="activity-container__image"
        src={ActivityAndSpacesImage.src}
        alt="Mapa de actividades y espacios"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="activity-container__button-wrapper">
      <a href="#" class="activity-container__button"> Ver el mapa </a>
    </div>
  </div>
</section>
