---
//@ts-nocheck
/**
 * About Vivir Plenamente page.
 *
 * Responsibilities:
 * - Present the editorial mission, vision, and target audience.
 * - Communicate core editorial values and guiding principles.
 * - Introduce the team behind the project.
 *
 * Notes:
 * - This component is fully static and content-driven.
 * - Editorial values and team members are defined locally for clarity
 *   and ease of future refactoring to a CMS if needed.
 */
import "./AboutVP.css";
import { Icon } from "astro-icon/components";
import BroadcastSchedules from "../shared/BroadcastSchedules.astro";
import { getAuthors } from "../../services/author.service";

const editorialValues = [
  {
    icon: "mdi:check-circle-outline",
    title: "Credibilidad",
    description: "Información verificada y fuentes confiables.",
  },
  {
    icon: "mdi:account-group-outline",
    title: "Cercanía",
    description: "Lenguaje claro, accesible y empático.",
  },
  {
    icon: "mdi:shield-check-outline",
    title: "Compromiso con los derechos",
    description: "Enfoque basado en derechos humanos de las personas mayores.",
  },
  {
    icon: "mdi:map-marker-radius-outline",
    title: "Identidad regional",
    description:
      "Mirada desde el territorio con proyección nacional e internacional.",
  },
  {
    icon: "mdi:hand-heart-outline",
    title: "Responsabilidad social",
    description: "Periodismo al servicio de las personas.",
  },
];

const teamMembers = await getAuthors();

---
<article class="about-vp__intro">
  <div class="intro__content">
    <h3 class="intro__title">
      Periodismo especializado en derecho de la vejez en Argentina. Vivir
      Plenamente es un medio periodístico multiplataforma especializado en
      derecho de la vejez y calidad de vida de las personas mayores en Argentina.
    </h3>

    <div class="intro__texts">
      <p>
        En <strong>Vivir Plenamente</strong> informamos, orientamos y acompañamos
        a personas mayores, sus familias y a quienes trabajan con ellas,
        brindando información clara, confiable y accesible para la toma de
        decisiones cotidianas vinculadas a salud, cuidados, recreación,
        trámites, jubilaciones y acceso a derechos.
      </p>

      <p>
        Hacemos periodismo de servicio, con enfoque en derechos humanos, que
        busca transformar información compleja en contenidos comprensibles y
        útiles, explicados paso a paso.
      </p>

      <p>
        Nuestro trabajo se apoya en los principios de la Convención
        Interamericana sobre la Protección de los Derechos Humanos de las
        Personas Mayores.
      </p>
    </div>
  </div>

  <div class="intro__visual">
    <img src="/assets/home-icon.webp" alt="Vivir Plenamente logo" />
  </div>
</article>

<section class="vp__pilars">
  <div class="pilars__container">
    <div class="pilar__mission">
      <Icon name="mdi:format-quote-close" />
      <h4 class="pilar__title">Nuestra misión</h4>
      <p>
        Brindar información periodística confiable y orientación clara para que
        las personas mayores y sus familias puedan conocer, ejercer y defender
        sus derechos.
      </p>
    </div>

    <div class="pilar__vision">
      <Icon name="mdi:eye-outline" />
      <h4 class="pilar__title">Nuestra visión</h4>
      <p>
        Ser un medio de referencia en comunicación sobre derecho de la vejez y
        personas mayores en Argentina.
      </p>
    </div>

    <div class="pilar__audience">
      <Icon name="mdi:earth" />
      <h4 class="pilar__title">A quienes nos dirigimos</h4>
      <ul class="pilar__list">
        <li>Personas mayores.</li>
        <li>Familias y redes de cuidado.</li>
        <li>Profesionales e instituciones.</li>
      </ul>
    </div>
  </div>
</section>

<section class="vp__values">
  <header class="values__header">
    <h3>Valores editoriales</h3>
    <p>Los pilares que guían cada contenido.</p>
  </header>

  <div class="values__grid">
    {editorialValues.map((item) => (
      <div class="value__card">
        <Icon name={item.icon} class="value__icon" />
        <h5>{item.title}</h5>
        <p>{item.description}</p>
      </div>
    ))}
  </div>
</section>

<section class="vp__integrants">
  <hr class="divisor" />

  <header class="vp-integrants__header">
    <h2>Quienes hacemos Vivir Plenamente</h2>
    <p>El equipo detrás del proyecto.</p>
  </header>

  <div class="team__grid">
    {teamMembers.map((member) => (
      <div class="team__card">
        <div class="team__photo-placeholder">
          {member.avatar ? (
            <img
              src={member.avatar.url}
              alt={member.avatar.alt}
              class="team__photo"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="team__photo team__photo--placeholder" />
          )}
        </div>

        <p class="team__name">{member.name}</p>
        <p class="team__role">{member.role}</p>
      </div>
    ))}
  </div>

  <hr class="divisor" />

  <div class="subtitle">
    <p>Vivir Plenamente informa para decidir, no solo para leer.</p>
  </div>
</section>

<div class="emission-footer">
  <BroadcastSchedules />
</div>
