---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <main class="not-found">
    <section class="not-found__content" role="alert">
      <h1 class="not-found__title">404</h1>

      <p class="not-found__subtitle">Página no encontrada</p>

      <p class="not-found__description">
        La página que buscas no existe o fue movida. Podés volver al inicio o
        explorar las secciones principales del sitio para encontrar la
        información que necesitás.
      </p>

      <nav class="not-found__actions" aria-label="Acciones principales">
        <a href="/" class="not-found__link">Ir al inicio</a>
      </nav>
    </section>
  </main>

  <style>
    .not-found {
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-xxxl) var(--space-md);
      background-color: var(--color-background);
    }

    .not-found__content {
      max-width: 560px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }

    .not-found__title {
      font-size: clamp(4rem, 10vw, 7rem);
      font-weight: 700;
      line-height: 1;
      margin: 0;
      color: var(--color-primary);
    }

    .not-found__subtitle {
      font-size: var(--font-size-xl);
      font-weight: 600;
      margin: 0;
      color: #000;
    }

    .not-found__description {
      font-size: var(--font-size-md);
      color: #444;
      line-height: 1.6;
      margin: 0;
    }

    .not-found__actions {
      margin-top: var(--space-lg);
      display: flex;
      justify-content: center;
      gap: var(--space-md);
      flex-wrap: wrap;
    }

    .not-found__link {
      font-size: var(--font-size-sm);
      padding: var(--space-sm) var(--space-xxl);
      border-radius: var(--space-xxxl);
      background-color: var(--color-primary);
      color: var(--color-background);
      font-weight: 600;
      text-decoration: none;
      border: 3px solid var(--color-secondary);
      transition: transform 0.3s ease-in-out;
    }

    .not-found__link--secondary {
      background-color: transparent;
    }

    .not-found__link:focus-visible {
      outline: 3px solid var(--color-primary);
      outline-offset: 4px;
    }

    .not-found__link:hover {
        transform: translateY(-3px)
    }

    @media (max-width: 768px) {
      .not-found {
        min-height: 60vh;
      }

      .not-found__subtitle {
        font-size: var(--font-size-lg);
      }

      .not-found__description {
        font-size: var(--font-size-sm);
      }
    }
  </style>
</MainLayout>
