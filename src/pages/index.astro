---
/**
 * Home Page
 * ---------
 * Main landing page of the site.
 *
 * Structure:
 * - Composed entirely of presentational sections.
 * - Each section is encapsulated in its own Astro component.
 * - Wrapped by the MainLayout, which provides global layout,
 *   navigation, and footer.
 *
 * Sections:
 * - HelpCenterOptions: Entry points to key help topics.
 * - DailyTools: Daily-use utilities.
 * - NewsAndRights: Highlighted news and rights-related content.
 * - AboutVivirPlenamente: Institutional and editorial overview.
 * - ColaboratePeriodism: Call to collaborate with the media outlet.
 * - ActivityAndSpaces: Activities, spaces, and community content.
 * - Sponsors: Sponsors and supporting organizations.
 *
 * Notes:
 * - This page contains no data fetching logic.
 * - All data responsibility is delegated to child components.
 */
import MainLayout from '../layouts/MainLayout.astro';
import HelpCenterOptions from '../components/home/HelpCenterOptions.astro';
import DailyTools from '../components/home/DailyTools.astro';
import NewsAndRights from '../components/home/NewsAndRights.astro';
import AboutVivirPlenamente from '../components/home/AboutVivirPlenamente.astro';
import ColaboratePeriodism from '../components/home/ColaboratePeriodism.astro';
import ActivityAndSpaces from '../components/home/ActivityAndSpaces.astro';
import Sponsors from '../components/home/Sponsors.astro';
import ProgramSchedule from '../components/home/ProgramSchedule.astro';
---

<MainLayout>
	<HelpCenterOptions />
	<DailyTools />
	<NewsAndRights />
	<AboutVivirPlenamente />
	<ColaboratePeriodism />
	<ProgramSchedule />
	<ActivityAndSpaces />
	<Sponsors />
</MainLayout>
