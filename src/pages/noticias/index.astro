---
// @ts-nocheck
export const prerender = false;

import NewsFeatured from "../../components/news/NewsFeatured.astro";
import NewsList from "../../components/news/NewsList.astro";
import Pagination from "../../components/news/Pagination.astro";
import Sidebar from "../../components/shared/Sidebar.astro";
import TitleBarTopPage from "../../components/shared/TitleBarTopPage.astro";
import Breadcrumb from "../../components/shared/Breadcrumb.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { getNews } from "../../services/news.service";

const { news: featuredResponse } = await getNews({
  page: 1,
  pageSize: 1,
});

const featuredNews = featuredResponse?.[0] ?? null;

const pageParam = Astro.url.searchParams.get("page");
const currentPage = pageParam ? Number(pageParam) : 1;

const { news: listNews = [], pagination } = await getNews({
  page: currentPage,
  pageSize: 4,
});

const breadcrumbItems = [
  { label: "Inicio", href: "/" },
  { label: "Noticias", href: "/noticias" },
  { label: `Página ${currentPage}`, href: null },
];
---

<MainLayout>
  <div class="news-layout">
    <div class="news-layout__header">
      <Breadcrumb items={breadcrumbItems} />
    </div>

    <TitleBarTopPage title="Todas las noticias" />

    <div class="news-page-wrapper">
      <main class="news-page__content">
        <div class="news-page-description">
          <p>
            Acceda a la última información sobre tus derechos, actividades,
            comunidades y mucho más. Descubre las últimas novedades y mantente
            al día con todo lo que necesitas saber.
          </p>
        </div>

        <section class="news-main">
          {featuredNews ? (
            <NewsFeatured news={featuredNews} />
          ) : (
            <div class="news-fallback">
              <p>No hay noticias destacadas disponibles en este momento.</p>
            </div>
          )}
        </section>

        <section class="news-grid">
          {listNews.length > 0 ? (
            <NewsList news={listNews} />
          ) : (
            <div class="news-fallback">
              <p>No se encontraron noticias para mostrar.</p>
            </div>
          )}
        </section>

        {pagination?.pageCount > 1 && (
          <Pagination
            currentPage={pagination.page}
            totalPages={pagination.pageCount}
            basePath="/noticias/"
          />
        )}
      </main>

      <aside class="news-sidebar">
        <Sidebar />
      </aside>
    </div>
  </div>

  <style>
    .news-page-wrapper {
      display: flex;
      justify-content: center;
      gap: 3rem;
      max-width: 1280px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .news-layout__header {
      display: flex;
      justify-content: flex-start;
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-sm) 0;
      padding-left: var(--space-sm);
    }

    .news-page__content {
      flex: 1;
      max-width: 800px;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .news-page-description p {
      font-size: var(--font-size-lg);
      color: #000;
      line-height: 1.6;
    }

    .news-main {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .news-grid {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .news-sidebar {
      width: 320px;
      flex-shrink: 0;
    }

    /* Fallback */
    .news-fallback {
      padding: 2rem;
      background-color: #f5f5f5;
      border-radius: 0.75rem;
    }

    .news-fallback p {
      margin: 0;
      font-size: var(--font-size-md);
      color: #444;
    }

    @media (max-width: 900px) {
      .news-page-wrapper {
        flex-direction: column;
      }

      .news-sidebar {
        display: none;
      }
    }
  </style>
</MainLayout>
