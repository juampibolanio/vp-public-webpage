---
/**
 * Content Hub Articles Page
 *
 * Renders a paginated list of articles for a given content hub.
 *
 * Responsibilities:
 * - Resolve hub metadata by slug.
 * - Fetch featured article (first page, single item).
 * - Fetch paginated articles list.
 * - Build breadcrumb navigation dynamically.
 *
 * Rendering logic:
 * - Shows a featured article when available.
 * - Displays article grid with pagination.
 * - Falls back to an empty state when no articles exist.
 *
 * Notes:
 * - Server-side rendering enabled (`prerender = false`).
 * - Pagination driven by `page` query param.
 */
//@ts-nocheck
export const prerender = false;

import Breadcrumb from "../../../components/shared/Breadcrumb.astro";
import TitleBarTopPage from "../../../components/shared/TitleBarTopPage.astro";
import MainLayout from "../../../layouts/MainLayout.astro";
import Sidebar from "../../../components/shared/Sidebar.astro";
import Pagination from "../../../components/news/Pagination.astro";
import FeaturedArticle from "../../../components/articles/FeaturedArticle.astro";
import ArticlesList from "../../../components/articles/ArticlesList.astro";

import { getContentHubBySlug } from "../../../services/content-hub.service";
import { getArticlesByHubSlug } from "../../../services/articles.service";

const { hub } = Astro.params;

const contentHubInfo = await getContentHubBySlug(hub);

if (!contentHubInfo) {
  throw new Error("Content hub not found");
}
const pageParam = Astro.url.searchParams.get("page");
const currentPage = pageParam ? Number(pageParam) : 1;

const featured = await getArticlesByHubSlug(hub, {
  page: 1,
  pageSize: 1,
});

const featuredArticle =
  Array.isArray(featured.articles) && featured.articles.length > 0
    ? featured.articles[0]
    : null;

const { articles, pagination } = await getArticlesByHubSlug(hub, {
  page: currentPage,
  pageSize: 6,
});

const hasArticles = Array.isArray(articles) && articles.length > 0;

const breadcrumbItems = [
  { label: "Inicio", href: "/" },
  { label: "Adultos Mayores", href: "/adultos-mayores" },
  { label: contentHubInfo.title, href: `/adultos-mayores/${contentHubInfo.slug}` },
  { label: `${currentPage}`, href: null },
];
---

<MainLayout title=`${contentHubInfo.title}`>
  <div class="articles-layout">
    <div class="articles-layout__header">
      <Breadcrumb items={breadcrumbItems} />
    </div>

    <TitleBarTopPage title={contentHubInfo.title} />

    <div class="articles-layout__wrapper">
      <div class="articles-layout__description">
        <p class="articles-layout__text">
          {contentHubInfo.description}
        </p>
      </div>

      {
        featuredArticle && (
          <div class="articles-layout__featured">
            <FeaturedArticle
              featArticle={featuredArticle}
              basePath={`/adultos-mayores/${hub}`}
            />
          </div>
        )
      }

      <div class="articles-layout__body">
        <div class="articles-layout__content">
          {
            hasArticles ? (
              <>
                <div class="articles-layout__grid">
                  <ArticlesList
                    articles={articles}
                    basePath={`/adultos-mayores/${hub}`}
                  />
                </div>

                <Pagination
                  currentPage={pagination.page}
                  totalPages={pagination.pageCount}
                  basePath={`/adultos-mayores/${contentHubInfo.slug}`}
                />
              </>
            ) : (
              <div class="articles-empty">
                <h2 class="articles-empty__title">
                  Aún no hay artículos en esta sección
                </h2>
                <p class="articles-empty__text">
                  Estamos trabajando en nuevos contenidos. Volvé a visitarnos
                  pronto.
                </p>
              </div>
            )
          }
        </div>

        <aside class="articles-layout__sidebar">
          <Sidebar />
        </aside>
      </div>
    </div>
  </div>

  <style>
    .articles-layout__header {
      max-width: 1250px;
      margin: 0 auto;
      padding: var(--space-sm);
    }

    .articles-layout__wrapper {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-xxl) var(--space-lg);
      display: flex;
      flex-direction: column;
      gap: var(--space-xxl);
    }

    .articles-layout__description {
      max-width: 720px;
    }

    .articles-layout__text {
      font-size: var(--font-size-md);
      color: var(--color-text-secondary);
    }

    .articles-layout__featured {
      width: 100%;
    }

    .articles-layout__body {
      display: flex;
      align-items: flex-start;
      gap: var(--space-xl);
      width: 100%;
    }

    .articles-layout__content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-xl);
    }

    .articles-layout__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .articles-layout__sidebar {
      width: 300px;
      flex-shrink: 0;
    }

    .articles-empty {
      padding: var(--space-xxl) var(--space-lg);
      border-radius: var(--radius-md);
      background-color: var(--color-surface-muted);
      text-align: center;
    }

    .articles-empty__title {
      margin: 0 0 var(--space-sm);
      font-size: var(--font-size-lg);
    }

    .articles-empty__text {
      margin: 0;
      font-size: var(--font-size-md);
      color: var(--color-text-secondary);
    }

    @media (max-width: 1024px) {
      .articles-layout__sidebar {
        width: 260px;
      }
    }

    @media (max-width: 900px) {
      .articles-layout__body {
        flex-direction: column;
      }

      .articles-layout__sidebar {
        display: none;
      }
    }
  </style>
</MainLayout>
