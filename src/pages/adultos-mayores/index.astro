---
/**
 * Adult Seniors – Content Hubs Page
 *
 * Page-level composition that groups multiple content hubs by category.
 *
 * Responsibilities:
 * - Fetch content hubs from Strapi by predefined categories.
 * - Organize hubs into thematic sections with contextual descriptions.
 * - Reuse `ContentHubCard` for consistent presentation and navigation.
 *
 * Data notes:
 * - Categories are resolved server-side at build/request time.
 * - Assumes normalized hub data from `getContentHubsByCategory`.
 *
 * UX notes:
 * - Sections are vertically stacked for readability.
 * - Includes a final call-to-action block for direct user assistance.
 */
//@ts-nocheck
import { Icon } from "astro-icon/components";
import ContentHubCard from "../../components/shared/ContentHubCard.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { getContentHubsByCategory } from "../../services/content-hub.service";
import Breadcrumb from "../../components/shared/Breadcrumb.astro";

const tramitesDerechos = await getContentHubsByCategory(
  "TRAMITES_DERECHOS",
);
const saludBienestar = await getContentHubsByCategory("SALUD_BIENESTAR");

const participacionCultura = await getContentHubsByCategory("PARTICIPACION_CULTURA");

const breadcrumbItems = [
  { label: "Inicio", href: "/" },
  { label: "Adultos Mayores", href: "/adultos-mayores" },
]
---

<MainLayout title="Adultos Mayores">
  <div class="old-adults-section">

    <Breadcrumb items={breadcrumbItems}/>

    <div class="old-adults__header">
      <h1 class="old-adults__title">Adultos Mayores</h1>
      <p class="old-adults__description">
        Esta etapa de la vida está llena de oportunidades para mantenerse activo,
        saludable y conectado. En esta sección, encontrarás información clave
        sobre tus derechos y trámites importantes, junto con recursos para
        cuidar tu salud y bienestar. Además, te ofrecemos ideas para que sigas
        participando en actividades culturales y sociales que te enriquezcan.
      </p>
    </div>


    <div class="content-hub__section">
      <div class="content-hub__header">
        <h3 class="content-hub__title">Trámites y Derechos</h3>
        <p class="content-hub__description">
          Información clara y accesible sobre jubilaciones, pensiones,
          beneficios y otros derechos para que puedas gestionarlos de forma sencilla.
        </p>
      </div>

      <div class="content-hub__body">
        { tramitesDerechos.map((item) => <ContentHubCard {...item} basePath="/adultos-mayores"/>)}
      </div>
    </div>

    <div class="content-hub__section">
      <div class="content-hub__header">
        <h3 class="content-hub__title">Salud y Bienestar</h3>
        <p class="content-hub__description">
          Consejos, guías y recursos para promover un envejecimiento activo,
          cuidar tu salud física y mental, y mantener tu autonomía.
        </p>
      </div>

      <div class="content-hub__body">
        { saludBienestar.map((item) => <ContentHubCard {...item} basePath="/adultos-mayores"/>)}
      </div>
    </div>

    <div class="content-hub__section">
      <div class="content-hub__header">
        <h3 class="content-hub__title">Participación y Cultura</h3>
        <p class="content-hub__description">
          Descubre propuestas y actividades para mantenerte conectado, disfrutar
          de tu tiempo libre y seguir aprendiendo.
        </p>
      </div>

      <div class="content-hub__body">
        { participacionCultura.map((item) => <ContentHubCard {...item} basePath="/adultos-mayores"/>)}
      </div>
    </div>

    <div class="help-section">
      <div class="help-section__body">
        <h3 class="help-section__title">¿Necesitás orientación específica?</h3>
        <p class="help-section__description">
          Estamos construyendo este espacio contigo. Si tenes dudas sobre un
          trámite específico o necesitas un recurso que no encuentras
          escríbenos.
        </p>
      </div>

      <a href="https://wa.link/2s0wl1" class="help-section__button">
        <Icon class="help-section__icon" name="mdi:whatsapp" size={42} />
        <span class="help-section__button-text">Whatsapp</span>
      </a>
    </div>
  </div>
</MainLayout>

<style>
  .old-adults-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .old-adults__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .old-adults__title {
    font-weight: 600;
    font-size: var(--font-size-xxxl);
    margin: 0;
  }

  .old-adults__description {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  .content-hub__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxl);
  }

  .content-hub__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .content-hub__title {
    font-size: var(--font-size-xxl);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid #e8e8e8;
    margin: 0;
  }

  .content-hub__description {
    font-size: var(--font-size-lg);
    max-width: 1100px;
  }

  .content-hub__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxxl);
  }

  .help-section {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .help-section__body {
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .help-section__title {
    margin: 0;
    font-size: var(--font-size-xxl);
  }

  .help-section__description {
    max-width: 1000px;
    font-size: var(--font-size-md);
  }

  .help-section__button {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-xxxl);
    border-radius: var(--space-xl);
    background-color: #25d366;
    transition: transform 0.3s ease-in-out;
    text-decoration: none;
    margin-top: var(--space-sm);
  }

  .help-section__button:hover {
    transform: translateY(-2px);
  }

  .help-section__icon {
    color: var(--color-background);
  }

  .help-section__button-text {
    font-size: var(--font-size-lg);
    font-weight: 500;
    color: var(--color-background);
  }
</style>
