---
/**
 * Family Section Page
 *
 * Page that groups content hubs oriented to families and caregivers.
 *
 * Responsibilities:
 * - Fetch content hubs by predefined categories.
 * - Render grouped ContentHubCard lists per section.
 * - Provide a contextual help call-to-action.
 */
//@ts-nocheck
import { Icon } from "astro-icon/components";
import ContentHubCard from "../../components/shared/ContentHubCard.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { getContentHubsByCategory } from "../../services/content-hub.service";
import Breadcrumb from "../../components/shared/Breadcrumb.astro";

const gestionDependenciaItems = await getContentHubsByCategory(
  "GESTION_DEPENDENCIA",
);
const vidaSocialItems = await getContentHubsByCategory("VIDA_SOCIAL");

const breadcrumbItems = [
  { label: "Inicio", href: "/" },
  { label: "Familias", href: "/familias" },
];
---

<MainLayout>
  <div class="family-section">
    <Breadcrumb items={breadcrumbItems} />

    <div class="family-section__header">
      <h1 class="family-section__title">Familias</h1>
      <p class="family-section__description">
        Sabemos que acompañar a un ser querido en una situación de dependencia
        es un camino lleno de desafíos y amor. En este espacio, queremos
        brindarte el apoyo que necesitas. Aquí encontrarás herramientas
        prácticas para la gestión del cuidado diario y recursos para fortalecer
        tu bienestar emocional y el de tu familia.
      </p>
    </div>

    <div class="content-hub__section">
      <div class="content-hub__header">
        <h3 class="content-hub__title">Gestión de la dependencia</h3>
        <p class="content-hub__description">
          Encuentra guías y recursos prácticos para organizar el cuidado diario,
          desde la gestión de trámites hasta la adaptación del hogar,
          facilitando un entorno seguro y tranquilo tanto para ti como para tu
          ser querido.
        </p>
      </div>

      <div class="content-hub__body">
        {
          gestionDependenciaItems.map((item) => (
            <ContentHubCard {...item} basePath="/familias" />
          ))
        }
      </div>
    </div>

    <div class="content-hub__section">
      <div class="content-hub__header">
        <h3 class="content-hub__title">Vida Social y Bienestar</h3>
        <p class="content-hub__description">
          El bienestar se construye en conjunto. En esta sección encontrarás
          recursos y propuestas para fortalecer la salud emocional, los vínculos
          sociales y la calidad de vida tanto de las personas mayores como de
          quienes las acompañan en su día a día.
        </p>
      </div>

      <div class="content-hub__body">
        {
          vidaSocialItems.map((item) => (
            <ContentHubCard {...item} basePath="/familias" />
          ))
        }
      </div>
    </div>

    <div class="help-section">
      <div class="help-section__body">
        <h3 class="help-section__title">¿Necesitás orientación específica?</h3>
        <p class="help-section__description">
          Estamos construyendo este espacio contigo. Si tenes dudas sobre un
          trámite específico o necesitas un recurso que no encuentras
          escríbenos.
        </p>
      </div>

      <a href="https://wa.link/2s0wl1" class="help-section__button">
        <Icon class="help-section__icon" name="mdi:whatsapp" size={42} />
        <span class="help-section__button-text">Whatsapp</span>
      </a>
    </div>
  </div>
</MainLayout>

<style>
  .family-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .family-section__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .family-section__title {
    font-weight: 600;
    font-size: var(--font-size-xxxl);
    margin: 0;
  }

  .family-section__description {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  .content-hub__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxl);
  }

  .content-hub__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .content-hub__title {
    font-size: var(--font-size-xxl);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid #e8e8e8;
    margin: 0;
  }

  .content-hub__description {
    font-size: var(--font-size-lg);
    max-width: 1100px;
  }

  .content-hub__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxxl);
  }

  .help-section {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .help-section__body {
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .help-section__title {
    margin: 0;
    font-size: var(--font-size-xxl);
  }

  .help-section__description {
    max-width: 1000px;
    font-size: var(--font-size-md);
  }

  .help-section__button {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-xxxl);
    border-radius: var(--space-xl);
    background-color: #25d366;
    transition: transform 0.3s ease-in-out;
    text-decoration: none;
    margin-top: var(--space-sm);
  }

  .help-section__button:hover {
    transform: translateY(-2px);
  }

  .help-section__icon {
    color: var(--color-background);
  }

  .help-section__button-text {
    font-size: var(--font-size-lg);
    font-weight: 500;
    color: var(--color-background);
  }
</style>
